# Скопируй в .env (в git не попадает) и поправь при необходимости — для локальной разработки
# в Docker подходят значения по умолчанию как есть.

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=tonsor
MYSQL_USER=tonsor
MYSQL_PASSWORD=tonsor

# --- WordPress ---
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=tonsor
WORDPRESS_DB_USER=tonsor
WORDPRESS_DB_PASSWORD=tonsor
WORDPRESS_TABLE_PREFIX=wp_

# Порт на хосте, по которому доступен WP (http://localhost:WP_PORT/)
WP_PORT=8080
SITE_URL=http://localhost:8080

# Учётка администратора, которую создаёт bootstrap.sh
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin12345
WP_ADMIN_EMAIL=admin@tonsorbarber.local
WP_TITLE=TONSOR

# Учётка клиента (роль Editor — карточки лендинга, без плагинов/темы/настроек)
TONSOR_USER=tonsor
TONSOR_USER_PASSWORD=tonsor12345
TONSOR_USER_EMAIL=tonsor@tonsorbarber.local

# Версии плагинов, которые ставит bootstrap.sh (закреплены; при обновлении плагинов поднять здесь и в bootstrap.sh)
ACF_VERSION=6.8.10
SCPO_VERSION=2.8.8
DUPLICATE_POST_VERSION=4.7
YOAST_SEO_VERSION=28.5
# 1 — разрешить bootstrap.sh понижать плагин, если стоит версия новее закреплённой
ALLOW_PLUGIN_DOWNGRADE=0
